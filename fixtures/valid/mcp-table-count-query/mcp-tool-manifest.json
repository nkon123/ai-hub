{
  "schema_version": "1.0",
  "id": "1099ae36-84f1-4d75-9390-d6a499efd8c8",
  "type": "mcp_tool",
  "name": "테이블 건수 조회",
  "version": "1.0.0",
  "owner": {
    "org": "miracom",
    "team": "platform",
    "creator_id": "admin@miracom.com"
  },
  "classification": "INTERNAL",
  "description": "허용된 Table과 Field/Operator 조합으로 행 개수만 조회합니다 (읽기 전용, 임의 SQL은 입력할 수 없고 행 내용은 반환하지 않습니다).",
  "tags": ["oracle", "readonly", "count"],
  "changelog": "D-049: 05-mcp-security-governance.md §5.3 table_count.query 의 Portal 등록용 Manifest. requires_user_confirmation=true 는 실제 정책보다 엄격한 쪽으로의 의도적 선택이다 — 이 Tool 의 서버 측 정책은 ON_PARAMETER 이지만 mcp-tool-manifest.schema.json 의 execution_guards 는 boolean 하나뿐이라 ON_PARAMETER 를 표현할 수 없다(apps/desktop-client/electron/mcp-tool-manifest.ts 가 true→ALWAYS, false→NEVER 로 사상). false 로 두면 D-080 등록이 confirmation_policy_weaker_than_builtin 으로 거절되므로, 표현할 수 없는 차이를 느슨한 쪽이 아니라 엄격한 쪽으로 반올림했다.",
  "created_at": "2026-08-15T09:00:00Z",
  "server_alias": "oracle-connector",
  "tool_name": "table_count.query",
  "risk_level": "READ_ONLY",
  "input_schema": {
    "type": "object",
    "required": ["schema", "table"],
    "additionalProperties": false,
    "properties": {
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "description": "Schema Allowlist에 포함된 Schema만 허용"
      },
      "table": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "description": "Table Allowlist에 포함된 Table만 허용"
      },
      "filters": {
        "type": "array",
        "maxItems": 5,
        "description": "Field Allowlist에 포함된 Field만 허용. 생략하면 전체 건수 조회이며 사용자 확인을 요구한다.",
        "items": {
          "type": "object",
          "required": ["field", "operator", "value"],
          "additionalProperties": false,
          "properties": {
            "field": { "type": "string", "maxLength": 64 },
            "operator": { "type": "string", "enum": ["eq", "neq"] },
            "value": { "type": ["string", "number", "boolean"] }
          }
        }
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["count"],
    "properties": {
      "count": { "type": "integer", "minimum": 0 }
    }
  },
  "execution_guards": {
    "timeout_seconds": 10,
    "max_rows": 1,
    "max_bytes": 1024,
    "requires_user_confirmation": true
  },
  "permissions": {
    "allowed_roles": ["USER", "CREATOR", "TECH_REVIEWER", "ADMIN"],
    "allowed_orgs": ["miracom"]
  }
}
