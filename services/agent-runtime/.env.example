# agent-runtime 설정 예시.
#
# 이 파일을 같은 폴더에 `.env` 로 복사해 쓰세요. `.env` 는 `.gitignore` 에
# 들어 있어 커밋되지 않습니다 — PC 마다 다른 값(경로, 포트)을 넣는 자리입니다.
#
# 규칙 두 가지:
#   * 모든 이름에 `AGENT_RUNTIME_` 접두어가 붙습니다.
#   * **목록형 값은 JSON 배열**이어야 합니다. 경로를 그냥 적으면 기동 시
#     `error parsing value for field ...` 로 죽습니다.
#   * 환경변수가 이 파일보다 우선합니다(스크립트에서 `$env:...` 로 준 값이 이김).
#
# 값을 실제로 바꿨는지는 `GET /local/v1/mcp-servers` 응답의
# `mcp_server_registration_enabled` / `stdio_supported` 로 확인할 수 있습니다.


# --- D-094 MCP 서버 등록 -----------------------------------------------------

# 등록 기능 스위치. 꺼져 있으면 HTTP·stdio 모두 거부됩니다
# (`mcp_server_registration_disabled`).
# AGENT_RUNTIME_MCP_SERVER_REGISTRATION_ENABLED=true

# stdio(내 PC 에서 직접 실행)를 쓰려면 `local` 이어야 합니다. 공유 서버에서
# 서드파티 코드를 띄우지 않기 위한 것이라 다른 설정으로 뚫을 수 없습니다.
# AGENT_RUNTIME_RUNTIME_MODE=local

# stdio 서버를 설치해도 되는 폴더. 여러 개면 `;`(Windows) / `:`(macOS·Linux)로
# 구분합니다. 값을 따옴표로 감싸지 마세요 — 큰따옴표 안에서는 역슬래시가
# 이스케이프로 해석되어(\a, \t, \U ...) 엉뚱한 경로가 됩니다.
# AGENT_RUNTIME_MCP_SERVER_INSTALL_ROOTS=C:\Dev\ai-hub\samples\mcp-servers
# AGENT_RUNTIME_MCP_SERVER_INSTALL_ROOTS=C:\Dev\ai-hub\samples\mcp-servers;C:\Users\me\AppData\Roaming\desktop-client\assets\mcp-servers
#
# JSON 배열도 그대로 받습니다(예전 형식). 이때는 역슬래시를 두 번 쓰거나
# 슬래시를 쓰세요 — 한 번만 쓰면 JSON 문법 오류로 서비스가 뜨지 않습니다.
# AGENT_RUNTIME_MCP_SERVER_INSTALL_ROOTS=["C:/Dev/ai-hub/samples/mcp-servers"]

# stdio 서버를 실행할 프로그램. 매니페스트는 "python"/"node" 라고만 말하고,
# 그것이 어느 실행 파일인지는 여기서만 정합니다 — 매니페스트가 실행 명령을
# 정하지 못하게 하는 지점입니다.
# AGENT_RUNTIME_MCP_PYTHON_INTERPRETER_PATH=C:/Dev/ai-hub/.venv/Scripts/python.exe
# AGENT_RUNTIME_MCP_NODE_INTERPRETER_PATH=C:/Program Files/nodejs/node.exe

# 등록 시 핸드셰이크 제한 시간(초).
# AGENT_RUNTIME_MCP_CONNECT_TIMEOUT_SECONDS=20

# 이 PC 의 대화 사용자가 MCP Tool 인가에서 갖는 역할(D-100). 아직 로그인이
# 없어 모든 대화가 같은 고정 사용자로 판정됩니다. 기본은 USER 이고, 매니페스트가
# CREATOR/ADMIN 만 허용하는 Tool 은 기본값으로는 호출이 거부됩니다
# (MCP_PERMISSION_DENIED). 모든 등록 서버의 판정에 함께 적용됩니다.
# 쉼표/세미콜론 구분 또는 JSON 배열. 비워 두면 기동이 거부됩니다(전부 거부 방지).
# AGENT_RUNTIME_POC_MCP_USER_ROLES=USER,CREATOR


# --- 그 밖에 자주 바꾸는 것 ---------------------------------------------------

# 설치된 모델과 다른 채팅 모델이 잡혀 있을 때. 단, Portal 관리자 화면(P15)에
# 저장된 값이 이것보다 우선합니다(D-092).
# AGENT_RUNTIME_CHAT_MODEL_ID=gemma4:latest

# 브라우저에서 이 서비스를 직접 부르는 화면의 Origin 목록(JSON 배열).
# 기본값은 search-runtime/office-mcp-server 와 동일하게 맞춰져 있습니다.
# AGENT_RUNTIME_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- 로컬 모델 지연 튜닝 ------------------------------------------------------
# 라우팅(지식 선택/Tool 선택/질의 재작성)은 JSON 한 줄만 받으면 되는데, 상한이
# 없으면 모델이 계속 이어 쓰다 타임아웃까지 가고 그 시간이 전부 대기 시간이
# 됩니다. 기본 160. 0 이하면 상한을 보내지 않습니다(예전 동작).
# AGENT_RUNTIME_ROUTER_MAX_OUTPUT_TOKENS=160

# Ollama가 모델을 메모리에 유지하는 시간. 기본값(5분)이면 잠깐 뜸한 사이 모델이
# 내려가 다음 질문이 로딩을 기다립니다. 비우면 필드를 보내지 않습니다.
# AGENT_RUNTIME_OLLAMA_KEEP_ALIVE=30m
