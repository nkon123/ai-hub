{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-manifest",
  "title": "Knowledge Package Manifest",
  "description": "Source manifest for a Knowledge index package",
  "type": "object",
  "required": ["schema_version", "id", "type", "name", "version", "owner", "classification", "source", "indexing_profile_ref"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "id": { "type": "string", "format": "uuid" },
    "type": { "type": "string", "const": "knowledge" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "owner": {
      "type": "object",
      "required": ["org", "creator_id"],
      "additionalProperties": false,
      "properties": {
        "org": { "type": "string" },
        "team": { "type": "string" },
        "creator_id": { "type": "string" }
      }
    },
    "classification": {
      "type": "string",
      "enum": ["PUBLIC_INTERNAL", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]
    },
    "description": { "type": "string", "maxLength": 1024 },
    "tags": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
    "manifest_hash": { "type": "string" },
    "changelog": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["type", "documents"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["local_files", "portal_upload"]
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "mime_type", "sha256"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!.*\\.\\.).*$",
                "description": "Relative path — no path traversal allowed"
              },
              "mime_type": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "language": { "type": "string", "default": "ko" }
            }
          }
        }
      }
    },
    "indexing_profile_ref": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "access_control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_orgs": { "type": "array", "items": { "type": "string" } },
        "allowed_roles": { "type": "array", "items": { "type": "string" } },
        "allowed_sites": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "questions_dataset": { "type": "string" },
        "recall_at_5_target": { "type": "number", "minimum": 0, "maximum": 1 },
        "p95_latency_ms_target": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
