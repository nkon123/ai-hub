{
  "schema_version": "1.0",
  "id": "7c473b66-b691-43ea-b530-a4703428730b",
  "type": "mcp_server",
  "name": "Outlook 메일 조회 (기간별)",
  "version": "1.0.1",
  "owner": {
    "org": "miracom",
    "team": "platform",
    "creator_id": "dev-user@miracom.com"
  },
  "classification": "INTERNAL",
  "description": "이 PC 의 클래식 Outlook(데스크톱)에서 기간을 지정해 받은/보낸 메일 목록과 본문을 읽는다. COM 으로 로컬 Outlook 만 읽으며 네트워크·계정 정보를 쓰지 않는다. 메일을 보내거나 지우거나 읽음 표시를 바꾸지 않는다(읽기 전용). 새 Outlook(olk)은 지원하지 않는다.",
  "tags": [
    "outlook",
    "email",
    "stdio",
    "read-only"
  ],
  "server_alias": "outlook-mail",
  "provenance": "INTERNAL",
  "protocol_version": "2025-06-18",
  "transport": {
    "kind": "STDIO",
    "interpreter": "python",
    "entrypoint": "server.py",
    "args": [],
    "vendored_dependencies": true
  },
  "declared_tools": [
    {
      "tool_name": "outlook.list_messages",
      "label": "Outlook 메일 가져오기·보여주기(오늘·최근 N일·기간, 받은·보낸 메일)",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "start_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "시작일 YYYY-MM-DD (그날 0시부터). days 와 함께 쓰지 않는다."
          },
          "end_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "종료일 YYYY-MM-DD (그날 끝까지 포함). 생략하면 시작일 하루 또는 오늘까지."
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 366,
            "description": "오늘을 포함한 최근 N일. 날짜를 정확히 모를 때 쓴다(예: 최근 3일이면 3)."
          },
          "folder": {
            "type": "string",
            "enum": [
              "inbox",
              "sent"
            ],
            "description": "inbox=받은편지함(기본), sent=보낸편지함"
          },
          "unread_only": {
            "type": "boolean",
            "description": "안 읽은 메일만 (기본 false)"
          },
          "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "최대 개수 (기본 20). 최신 메일부터."
          }
        }
      },
      "risk_level": "READ_ONLY",
      "permissions": {
        "allowed_roles": [
          "USER",
          "CREATOR",
          "ADMIN"
        ],
        "allowed_orgs": [
          "miracom"
        ]
      },
      "data_classification": "INTERNAL",
      "confirmation_policy": "ALWAYS",
      "execution_guards": {
        "timeout_seconds": 30,
        "max_bytes": 65536,
        "rate_limit_per_minute": 20
      }
    },
    {
      "tool_name": "outlook.get_message",
      "label": "Outlook 메일 한 통의 본문을 읽습니다",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "outlook.list_messages 결과의 id"
          },
          "max_chars": {
            "type": "integer",
            "minimum": 200,
            "maximum": 20000,
            "description": "본문 최대 글자 수 (기본 4000)"
          }
        }
      },
      "risk_level": "READ_ONLY",
      "permissions": {
        "allowed_roles": [
          "USER",
          "CREATOR",
          "ADMIN"
        ],
        "allowed_orgs": [
          "miracom"
        ]
      },
      "data_classification": "INTERNAL",
      "confirmation_policy": "ALWAYS",
      "execution_guards": {
        "timeout_seconds": 30,
        "max_bytes": 65536,
        "rate_limit_per_minute": 20
      }
    }
  ]
}
