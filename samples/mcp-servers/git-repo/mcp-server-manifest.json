      "confirmation_policy": "ALWAYS",
      "execution_guards": {
        "timeout_seconds": 45,
        "max_bytes": 262144,
        "rate_limit_per_minute": 30
      }
    },
    {
      "tool_name": "git.search",
      "label": "git 저장소에서 글자 검색(파일·줄 번호)",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repo": {
            "type": "string",
            "maxLength": 64,
            "description": "저장소 이름. 등록된 저장소가 하나뿐이면 생략한다."
          },
          "ref": {
            "type": "string",
            "maxLength": 200,
